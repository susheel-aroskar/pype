# Copy this file to .env and adjust values to taste, OR export the same names as real
# environment variables. The pype-client library reads them via pydantic-settings with the
# PYPE_CLIENT_ prefix; only the listed values are used. Real env vars take precedence over
# the .env file.

# Base URL of the pype server (scheme + host + port). No trailing slash.
PYPE_CLIENT_BASE_URL=http://localhost:8000

# Extra wall-clock buffer added on top of the per-call timeout when the client tells
# the underlying `requests` library how long to wait. Lets the server return its own
# timeout response (204 / 503) cleanly before the client cuts the connection. Default 1000.
PYPE_CLIENT_NETWORK_BUFFER_MS=1000

# HTTP timeout (ms) used for the auth endpoints (POST /auth/service, POST /auth/client,
# DELETE /auth/client). These calls are non-blocking on the server, so this value is used
# directly without adding network_buffer_ms. Default 5000.
PYPE_CLIENT_AUTH_TIMEOUT_MS=5000
